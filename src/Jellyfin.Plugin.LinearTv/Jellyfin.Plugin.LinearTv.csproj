<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.LinearTv</RootNamespace>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- PDB is required for any container-side debugging; see docs/plan.md section 7. -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls in Jellyfin.Model and Jellyfin.Common transitively. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.LinearTv.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded resource path is CASE-SENSITIVE once deployed to the Linux container. -->
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
