<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds Linear TV channels on a PC: resolves a channel file against a Jellyfin server, encodes
    each item with ffmpeg, and assembles each channel into one continuous MPEG-TS for the plugin's
    store. See docs/architecture.md. Runs on the host, not in a container: ./x builder publishes it
    as a self-contained executable, so the host needs no .NET SDK.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LinearTv.Builder</RootNamespace>
    <AssemblyName>linear-tv-builder</AssemblyName>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The store format and the TS splicer, shared with the plugin as source: the plugin ships as
         one DLL, and the builder must not depend on Jellyfin's server assemblies. -->
    <Compile Include="..\Jellyfin.Plugin.LinearTv\Store\ChannelManifest.cs" Link="Shared\ChannelManifest.cs" />
    <Compile Include="..\Jellyfin.Plugin.LinearTv\Store\KeyframeIndex.cs" Link="Shared\KeyframeIndex.cs" />
    <Compile Include="..\Jellyfin.Plugin.LinearTv\LiveTv\TsSplicer.cs" Link="Shared\TsSplicer.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinearTv.Builder.Tests" />
  </ItemGroup>

</Project>
